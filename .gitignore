# Lista permitida: novos arquivos exigem revisão explícita.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/config.example.py
!/configuracao_publica.py
!/acesso_sistema.py
!/automacao.py
!/leitor_csv.py
!/processamento_lote.py
!/reprocessar_pendencias.py
!/dados_ficticios.py
!/demo.py
!/main.py
!/REVISAO_PUBLICACAO.md
!/MANIFESTO_PUBLICACAO.sha256
!/tests/
/tests/*
!/tests/test_projeto.py
!/scripts/
/scripts/*
!/scripts/auditar_publicacao.py

# Defesa adicional para dados, ambientes, credenciais e artefatos de execução.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.env
**/.env.*
**/config.py
**/config.local.py
**/*.csv
**/*.tsv
**/*.log
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*cookie*
**/*token*
**/credentials*
**/dados/
**/logs/
**/backups/
**/.DS_Store
